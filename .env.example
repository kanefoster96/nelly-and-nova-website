# Transactional email via Resend. Used by the contact form, booking requests
# (team notification + customer confirmation), and onboarding confirmations
# (customer's training day + first start date). All sends are best-effort — the
# app works without these set; emails simply don't go out. Set them in your
# environment (e.g. Vercel → Project → Settings → Environment Variables).

# Resend API key — sign up free at https://resend.com, create an API key.
RESEND_API_KEY=

# Where enquiries are sent. Defaults to contact.email in config/site.ts if unset.
CONTACT_TO_EMAIL=charlotte@nellyandnova.co.uk

# The "from" address. In Resend's sandbox use "Nelly & Nova <onboarding@resend.dev>".
# Once you verify your domain in Resend, switch to e.g. "Nelly & Nova <hello@nellyandnova.co.uk>".
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Supabase (auth + database). Create a project at https://supabase.com, then
# Project Settings → API. These two are safe to expose to the browser.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key (Project Settings → API → Project API keys).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY secret. The service_role / secret key bypasses Row Level Security,
# so it must NEVER be prefixed NEXT_PUBLIC_ or used in client components. Only
# used in server code for staff/admin actions. Leave unset until needed.
SUPABASE_SERVICE_ROLE_KEY=
