# Copy to .env.local for local dev. For EAS builds and updates, set these as
# EAS environment variables instead (expo.dev → project → Environment variables,
# or `npx eas-cli env:create`) for the development, preview and production
# environments. Same values as the website's NEXT_PUBLIC_SUPABASE_* vars —
# the anon key is public by design; never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SITE_URL=https://nelly-and-nova-website.vercel.app
