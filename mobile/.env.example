# Supabase (auth + database) — same project as the website, so accounts,
# dogs and session data are shared. Project Settings → API in Supabase.
# These are safe to expose (bundled into the app); the anon key only grants
# what Row Level Security allows.

# Project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
